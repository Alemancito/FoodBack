# =========================================================
# FOODBACK - ENVIRONMENT
# =========================================================

# development | production
FOODBACK_ENVIRONMENT=development

# En producción DEBE ser una clave larga, aleatoria y única.
# Nunca copies aquí la SECRET_KEY real.
SECRET_KEY=

# Solo necesarias en producción.
# Ejemplo:
# FOODBACK_ALLOWED_HOSTS=foodback.com,.foodback.com,app.up.railway.app
# FOODBACK_CSRF_TRUSTED_ORIGINS=https://foodback.com,https://*.foodback.com,https://app.up.railway.app
FOODBACK_ALLOWED_HOSTS=
FOODBACK_CSRF_TRUSTED_ORIGINS=

# Dominio base usado para resolver tenants por subdominio.
FOODBACK_BASE_DOMAIN=foodbacksv.com

# Solo desarrollo/local.
# En producción no debe utilizarse como fallback.
FOODBACK_DEFAULT_TENANT_SLUG=rancheritos

# Solo habilitar detrás de un proxy confiable correctamente configurado.
FOODBACK_TRUST_X_REAL_IP=False


# =========================================================
# POSTGRESQL
# =========================================================

# app | migrator | test
FOODBACK_DB_MODE=app

FOODBACK_DB_NAME=foodback_local
FOODBACK_DB_HOST=127.0.0.1
FOODBACK_DB_PORT=5432

# Runtime normal de Django.
FOODBACK_DB_APP_USER=foodback_app
FOODBACK_DB_APP_PASSWORD=

# NO debe entregarse al proceso web de producción.
# Usar únicamente para migraciones.
FOODBACK_DB_MIGRATOR_USER=foodback_migrator
FOODBACK_DB_MIGRATOR_PASSWORD=

# Solo pruebas.
FOODBACK_DB_TEST_USER=foodback_test
FOODBACK_DB_TEST_PASSWORD=


# Máximo absoluto de una sesión autenticada del personal.
# 54000 segundos = 15 horas.
FOODBACK_STAFF_SESSION_MAX_AGE=54000


# =========================================================
# CLOUDINARY
# =========================================================

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=


# =========================================================
# GOOGLE MAPS
# =========================================================

# Esta key llega al navegador.
# Debe restringirse en Google Cloud por:
# - HTTP referrers permitidos
# - APIs permitidas
GOOGLE_MAPS_API_KEY=


# =========================================================
# WOMPI
# =========================================================

# Compatibilidad/fallback.
WOMPI_APP_ID=
WOMPI_API_SECRET=

# Cuenta utilizada para pagos de restaurantes/pedidos.
WOMPI_RESTAURANT_APP_ID=
WOMPI_RESTAURANT_API_SECRET=

# Cuenta utilizada por FoodBack para suscripciones SaaS.
WOMPI_PLATFORM_APP_ID=
WOMPI_PLATFORM_API_SECRET=

WOMPI_AUTH_URL=https://id.wompi.sv/connect/token
WOMPI_API_URL=https://api.wompi.sv/EnlacePago

WOMPI_NOTIFICATION_EMAIL=
WOMPI_RESTAURANT_NOTIFICATION_EMAIL=
WOMPI_PLATFORM_NOTIFICATION_EMAIL=


# =========================================================
# WOMPI - PROTECCIONES / CIRCUIT BREAKER
# =========================================================

WOMPI_USER_FAILURE_LIMIT=5
WOMPI_USER_FAILURE_WINDOW_MINUTES=30
WOMPI_USER_COOLDOWN_MINUTES=30

WOMPI_GLOBAL_FAILURE_LIMIT=5
WOMPI_GLOBAL_MIN_DISTINCT_CLIENTS=3
WOMPI_GLOBAL_FAILURE_WINDOW_MINUTES=10
WOMPI_GLOBAL_COOLDOWN_MINUTES=15


# =========================================================
# FOODBACK - NEGOCIO
# =========================================================

FOODBACK_SUBSCRIPTION_PRICE=50.00
PENDING_ORDER_EXPIRATION_MINUTES=45


# =========================================================
# LOGIN RATE LIMIT
# =========================================================

FOODBACK_LOGIN_IP_LIMIT=30
FOODBACK_LOGIN_USER_LIMIT=8
FOODBACK_LOGIN_WINDOW_SECONDS=600
FOODBACK_LOGIN_BLOCK_SECONDS=900


# =========================================================
# CHECKOUT RATE LIMIT
# =========================================================

FOODBACK_CHECKOUT_SESSION_LIMIT=10
FOODBACK_CHECKOUT_IP_LIMIT=120
FOODBACK_CHECKOUT_WINDOW_SECONDS=600
FOODBACK_CHECKOUT_BLOCK_SECONDS=600


# =========================================================
# WOMPI PAYMENT START RATE LIMIT
# =========================================================

FOODBACK_WOMPI_START_SESSION_LIMIT=10
FOODBACK_WOMPI_START_IP_LIMIT=120
FOODBACK_WOMPI_START_WINDOW_SECONDS=600
FOODBACK_WOMPI_START_BLOCK_SECONDS=600


# =========================================================
# PAYMENT RESUME RATE LIMIT
# =========================================================

FOODBACK_PAYMENT_RESUME_SESSION_LIMIT=10
FOODBACK_PAYMENT_RESUME_IP_LIMIT=120
FOODBACK_PAYMENT_RESUME_WINDOW_SECONDS=600
FOODBACK_PAYMENT_RESUME_BLOCK_SECONDS=600


# =========================================================
# SUBSCRIPTION PAYMENT RATE LIMIT
# =========================================================

FOODBACK_SUBSCRIPTION_PAYMENT_USER_LIMIT=10
FOODBACK_SUBSCRIPTION_PAYMENT_IP_LIMIT=60
FOODBACK_SUBSCRIPTION_PAYMENT_WINDOW_SECONDS=600
FOODBACK_SUBSCRIPTION_PAYMENT_BLOCK_SECONDS=600


# =========================================================
# WOMPI WEBHOOK
# =========================================================

FOODBACK_WOMPI_WEBHOOK_MAX_BYTES=262144


# =========================================================
# PENDING ORDER ACTIONS RATE LIMIT
# =========================================================

FOODBACK_PENDING_ORDER_ACTION_SESSION_LIMIT=10
FOODBACK_PENDING_ORDER_ACTION_IP_LIMIT=120
FOODBACK_PENDING_ORDER_ACTION_WINDOW_SECONDS=600
FOODBACK_PENDING_ORDER_ACTION_BLOCK_SECONDS=600


# =========================================================
# PASSWORD RESET
# =========================================================

# Código válido por 10 minutos.
FOODBACK_PASSWORD_RESET_CODE_TTL_SECONDS=600

# Intentos incorrectos antes de invalidar el desafío.
FOODBACK_PASSWORD_RESET_MAX_ATTEMPTS=5

# Tiempo para completar el cambio después de verificar el código.
FOODBACK_PASSWORD_RESET_GRANT_TTL_SECONDS=600


# =========================================================
# PASSWORD RESET - REQUEST RATE LIMIT
# =========================================================

FOODBACK_PASSWORD_RESET_REQUEST_IP_LIMIT=10
FOODBACK_PASSWORD_RESET_REQUEST_EMAIL_LIMIT=3
FOODBACK_PASSWORD_RESET_VERIFY_IP_LIMIT=30
FOODBACK_PASSWORD_RESET_REQUEST_WINDOW_SECONDS=900
FOODBACK_PASSWORD_RESET_REQUEST_BLOCK_SECONDS=900


# =========================================================
# EMAIL
# =========================================================

# Desarrollo: los correos se muestran en la terminal.
FOODBACK_EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend

# Producción futura con SMTP real:
# FOODBACK_EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
#
# Si usamos Gmail, usar contraseña de aplicación, nunca la contraseña
# normal de la cuenta:
# FOODBACK_EMAIL_HOST=smtp.gmail.com
# FOODBACK_EMAIL_PORT=587
# FOODBACK_EMAIL_HOST_USER=correo@dominio.com
# FOODBACK_EMAIL_HOST_PASSWORD=
# FOODBACK_EMAIL_USE_TLS=True

FOODBACK_DEFAULT_FROM_EMAIL=no-reply@foodback.local

FOODBACK_EMAIL_HOST=
FOODBACK_EMAIL_PORT=587
FOODBACK_EMAIL_HOST_USER=
FOODBACK_EMAIL_HOST_PASSWORD=
FOODBACK_EMAIL_USE_TLS=True
FOODBACK_EMAIL_TIMEOUT=10


# =========================================================
# SECURITY INCIDENTS / FOUNDATION ALERTING
# =========================================================

# Eventos equivalentes ocurridos dentro de esta ventana se correlacionan
# para formar/actualizar un mismo incidente.
FOODBACK_SECURITY_INCIDENT_WINDOW_SECONDS=300

# Máximo un aviso del mismo incidente cada 5 minutos mientras continúe.
# Un request individual NO equivale a un correo individual.
FOODBACK_SECURITY_ALERT_COOLDOWN_SECONDS=300

# Opt-in. Mantener False hasta configurar y probar correo real.
FOODBACK_SECURITY_ALERTS_ENABLED=False

# Destinatario interno Foundation/Superadmin.
# Puede aceptar varios correos separados por coma en el futuro.
FOODBACK_SECURITY_ALERT_EMAIL=


# =========================================================
# AUDITORÍA / RETENCIÓN
# =========================================================

# Días de conservación de eventos crudos de auditoría.
FOODBACK_AUDIT_RETENTION_DAYS=180

# Días de conservación de incidentes de seguridad resueltos.
# Debe ser >= FOODBACK_AUDIT_RETENTION_DAYS.
FOODBACK_SECURITY_INCIDENT_RETENTION_DAYS=365

# Tamaño de lote del comando de limpieza.
FOODBACK_AUDIT_CLEANUP_BATCH_SIZE=1000
