# --- SEGURIDAD / SECRETOS ---
.env
.env.*
!.env.example

# --- BACKUPS / DISASTER RECOVERY ---
# Nunca versionar dumps, metadatos ni temporales de backup.
backups/*
!backups/.gitkeep
*.backup
*.backup.json
*.dump
*.sql.gz
*.partial
*.backup_*
*.bak

# --- VS Code local workspace ---
.vscode/

# --- Python ---
__pycache__/
*.pyc
*.pyo

# --- Base de Datos Local ---
db.sqlite3

# --- Entornos Virtuales ---
venv/
env/
.venv/

# --- Archivos Estáticos y Media ---
staticfiles/
media/

# --- Sistema Operativo ---
.DS_Store
Thumbs.db
